@*
    Per-object heap listing (task 3.3). Copies ClrModules.cshtml's shape exactly -- see
    DumpHeap.cshtml's doc comment for the four rules all templates exist to demonstrate.

    Columns: object address, MethodTable, size (with byte count in title), type name (middle-
    truncated, because type names are distinguished by their tail), and generation (which may
    be null, rendered as "-").

    Task 4.1-4.3: filter bar, chips and sortable headers inside one <form> -- see
    _FilterBar.cshtml's doc comment. HeapAnalyzer.GetObjects only recognizes "size" and "address" as
    SortBy values, so MethodTable, Type and Gen stay plain, unsortable headers.

    Task 4.4: the <tr> loop lives in _ListObjRows.cshtml -- see DumpHeap.cshtml's doc comment for why.
*@
@model ListModel<HeapObjectItem>
@{
    var filterBar = FilterBar.Build(Model.View, Context.Request.Query);
    var addressSort = SortHeader.For(Model.View, Context.Request.Query, "address", SortDirection.Asc);
    var sizeSort = SortHeader.For(Model.View, Context.Request.Query, "size", SortDirection.Desc);
}

<div id="v-@Model.View.Name">
    <form class="dn-filterform">
        <partial name="/Views/Shared/_FilterBar.cshtml" model="@filterBar" />
        <table class="dn-table">
            <thead>
                <tr>
                    <th scope="col" class="dn-th dn-th--mono" aria-sort="@addressSort.AriaSort">
                        <a class="dn-th__sort" hx-get="@addressSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">Address@(addressSort.Indicator)</a>
                    </th>
                    <th scope="col" class="dn-th dn-th--mono">MethodTable</th>
                    <th scope="col" class="dn-th dn-th--num" aria-sort="@sizeSort.AriaSort">
                        <a class="dn-th__sort" hx-get="@sizeSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">Size@(sizeSort.Indicator)</a>
                    </th>
                    <th scope="col" class="dn-th">Type</th>
                    <th scope="col" class="dn-th">Gen</th>
                </tr>
            </thead>
            <tbody id="rows-@Model.View.Name">
                <partial name="/Views/Fragments/_ListObjRows.cshtml" model="@Model" />

                @if (Model.Result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="dn-empty">
                            @* Three different empty states are distinguished, per DESIGN_BRIEF.md §5:
                               an unfiltered empty result means the dump holds no objects of this kind,
                               whereas a filtered one means the filter is too narrow -- and telling a
                               user "no data" when they have simply over-filtered sends them looking
                               for a problem in the dump. *@
                            @if (Model.Result.TotalUnfiltered > 0)
                            {
                                <div class="dn-empty__title">No objects match the current filter.</div>
                                <a class="dn-btn" href="@(filterBar.ClearAllUrl ?? $"/views/{Model.View.Name}")">Clear filters</a>
                            }
                            else
                            {
                                <div class="dn-empty__title">This dump has no objects to show.</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
</div>
