@*
    The row loop for PrintException.cshtml, factored out (task 4.4) -- see _DumpHeapRows.cshtml's
    doc comment for why this exists and what the trailing sentinel <tr> does.
*@
@model ListModel<ThreadExceptionInfo>
@foreach (var item in Model.Result.Items)
{
    @if (item.Exception is not null)
    {
        var type = MiddleTruncated.From(item.Exception.TypeName);
        <tr class="dn-tr">
            <td class="dn-td">@Display.ThreadOrHeap(item.ManagedThreadId, item.OSThreadId)</td>
            <td class="dn-td dn-td--mono"><span class="dn-addr">@Display.Address(item.Exception.Address)</span></td>
            <td class="dn-td dn-td--type" title="@type.Full">
                <span class="dn-trunc"><span class="dn-trunc__head">@type.Head</span><span class="dn-trunc__tail">@type.Tail</span></span>
            </td>
            <td class="dn-td">@Display.OrNone(item.Exception.Message)</td>
        </tr>
    }
}

@if (Model.Result.HasMore)
{
    int nextOffset = Model.Result.Offset + Model.Result.Items.Count;
    string href = InfiniteScroll.SentinelHref(Model.View, Context.Request.Query, nextOffset, Model.Result.Limit);
    <tr hx-get="@href" hx-trigger="revealed" hx-swap="afterend" hx-target="this">
        <td colspan="4" class="dn-sentinel"><span class="dn-sentinel__muted">Loading&hellip;</span></td>
    </tr>
}
