@*
    Single-object detail (task 3.4). The reference implementation for every address-taking detail
    view (verifyobj, dumpmt, dumpmd, dumpclass, dumpmodule, dumpassembly, ip2md): a card whose head
    is the record's own identity, plus a table for whatever it contains -- the field list here,
    reusing .dn-table rather than a third table style.

    Same discipline as every other fragment: no style=, the htmx id derived from Model.View.Name,
    no conditionals beyond presence/absence, and formatting logic staying out of the template.

    The head row order and value styling (address vs. mono-strong vs. plain mono) are lifted from
    design-sync/Detail.dc.html's "object detail card". One deliberate consistency fix over that
    mockup: MethodTable there uses plain mono, but every address value elsewhere in this app --
    object address, handle address, owner thread -- already gets the dashed-underline .dn-addr
    treatment (task 3.3), so MethodTable gets it here too rather than being the one exception.

    The fields table's Value column shows a reference field's target address (styled the same way)
    instead of a separate Address column the design mockup didn't have -- a field's "value" for a
    reference type *is* the address it points to.
*@
@model DetailModel<ObjectDetails>

<div id="v-@Model.View.Name">
    <div class="dn-card">
        <div class="dn-card__head">
            <div class="dn-card__row"><span class="dn-card__label">Address</span><span class="dn-addr">@Display.Address(Model.Data.Address)</span></div>
            <div class="dn-card__row"><span class="dn-card__label">Type</span><span class="dn-mono--strong">@Model.Data.TypeName</span></div>
            <div class="dn-card__row"><span class="dn-card__label">Size</span><span class="dn-mono" title="@Display.Bytes((long)Model.Data.Size)">@Display.Size((long)Model.Data.Size)</span></div>
            <div class="dn-card__row"><span class="dn-card__label">MethodTable</span>@Display.AddrLink("dumpmt", Model.Data.MethodTable)</div>
            @if (!string.IsNullOrEmpty(Model.Data.Value))
            {
                <div class="dn-card__row"><span class="dn-card__label">Value</span><span class="dn-mono">@Model.Data.Value</span></div>
            }
            @*
                The object tree's only entry point (DATA_CONTRACT.md §4.5, TreeCatalog.cs): it needs an
                address nobody has until they are already looking at an object, so it is linked from
                here rather than from top-level navigation. A plain link, not an hx-get -- following it
                is a navigation, and the address bar is this tree's history.
            *@
            <div class="dn-card__row">
                <span class="dn-card__label">References</span>
                <a href="/trees/object/@Display.Address(Model.Data.Address)">View references →</a>
            </div>
            @*
                gcroot's own entry point, missing until now: it needs an address the same way the
                object tree does, but unlike that tree it never got a link from here, so the only way
                to reach /trees/gcroot/{address} was to already have one to type in by hand.
            *@
            <div class="dn-card__row">
                <span class="dn-card__label">Retention</span>
                <a href="/trees/gcroot/@Display.Address(Model.Data.Address)">View retention path →</a>
            </div>
        </div>
        <table class="dn-table">
            <thead>
                <tr>
                    <th scope="col" class="dn-th dn-th--mono">Offset</th>
                    <th scope="col" class="dn-th">Type</th>
                    <th scope="col" class="dn-th dn-th--mono">Name</th>
                    <th scope="col" class="dn-th dn-th--mono">Value</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var field in Model.Data.Fields)
                {
                    var type = MiddleTruncated.From(field.TypeName);
                    <tr class="dn-tr">
                        <td class="dn-td dn-td--mono">@Display.FieldOffset(field.Offset)</td>
                        <td class="dn-td dn-td--type" title="@type.Full">
                            <span class="dn-trunc"><span class="dn-trunc__head">@type.Head</span><span class="dn-trunc__tail">@type.Tail</span></span>
                        </td>
                        <td class="dn-td dn-td--mono">@field.Name</td>
                        <td class="dn-td dn-td--mono">
                            @if (field.IsReference && field.Address != 0)
                            {
                                @Display.AddrLink("dumpobj", field.Address)
                            }
                            else
                            {
                                @field.Value
                            }
                        </td>
                    </tr>
                }

                @if (Model.Data.Fields.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="dn-empty">
                            <div class="dn-empty__title">This object has no instance fields.</div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
