@*
    The GC handles list (task 3.3). Copies DumpHeap.cshtml's shape exactly -- see that file's
    doc comment for the four rules this repeats: no style=, the htmx contract as markup, no
    conditionals beyond presence/absence, and formatting logic staying out of the template.

    The columns mirror MarkdownFormatter.FormatGCHandles: handle address (mono), object address
    (mono), kind, strong (bool as text), ref count (with "-" when zero), type name.

    Task 4.1-4.3: filter bar, chips and sortable headers inside one <form> -- see
    _FilterBar.cshtml's doc comment. HeapAnalyzer.GetGCHandles only recognizes "kind" and
    "typename" as SortBy values (anything else falls back to Address), so Handle, Object, Strong,
    RefCount and Dependent stay plain, unsortable headers.

    Task 4.4: the <tr> loop lives in _GCHandlesRows.cshtml -- see DumpHeap.cshtml's doc comment for why.
*@
@model ListModel<GCHandleInfo>
@{
    var filterBar = FilterBar.Build(Model.View, Context.Request.Query);
    var kindSort = SortHeader.For(Model.View, Context.Request.Query, "kind", SortDirection.Asc);
    var typeSort = SortHeader.For(Model.View, Context.Request.Query, "typename", SortDirection.Asc);
}

<div id="v-@Model.View.Name">
    <form class="dn-filterform">
        <partial name="/Views/Shared/_FilterBar.cshtml" model="@filterBar" />
        <table class="dn-table">
            <thead>
                <tr>
                    <th scope="col" class="dn-th dn-th--mono">Handle</th>
                    <th scope="col" class="dn-th dn-th--mono">Object</th>
                    <th scope="col" class="dn-th" aria-sort="@kindSort.AriaSort">
                        <a class="dn-th__sort" hx-get="@kindSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">Kind@(kindSort.Indicator)</a>
                    </th>
                    <th scope="col" class="dn-th">Strong</th>
                    <th scope="col" class="dn-th dn-th--num">RefCount</th>
                    <th scope="col" class="dn-th dn-th--mono">Dependent</th>
                    <th scope="col" class="dn-th" aria-sort="@typeSort.AriaSort">
                        <a class="dn-th__sort" hx-get="@typeSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">Type@(typeSort.Indicator)</a>
                    </th>
                </tr>
            </thead>
            <tbody id="rows-@Model.View.Name">
                <partial name="/Views/Fragments/_GCHandlesRows.cshtml" model="@Model" />

                @if (Model.Result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="dn-empty">
                            @* Per DESIGN_BRIEF.md §5: an unfiltered empty result means the dump has no
                               GC handles, whereas a filtered one means the filter is too narrow. *@
                            @if (Model.Result.TotalUnfiltered > 0)
                            {
                                <div class="dn-empty__title">No handles match the current filter.</div>
                                <a class="dn-btn" href="@(filterBar.ClearAllUrl ?? $"/views/{Model.View.Name}")">Clear filters</a>
                            }
                            else
                            {
                                <div class="dn-empty__title">This dump has no GC handles to show.</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
</div>
