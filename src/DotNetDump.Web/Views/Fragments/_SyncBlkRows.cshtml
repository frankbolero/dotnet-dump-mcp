@*
    The row loop for SyncBlk.cshtml, factored out (task 4.4) -- see _DumpHeapRows.cshtml's doc
    comment for why this exists and what the trailing sentinel <tr> does.
*@
@model ListModel<SyncBlockInfo>
@foreach (var item in Model.Result.Items)
{
    var type = MiddleTruncated.From(item.TypeName);
    string owner = item.ManagedThreadId.HasValue
        ? Display.Count(item.ManagedThreadId.Value)
        : (item.HoldingThreadAddress != 0 ? "@" + Display.Address(item.HoldingThreadAddress) : "none");
    string kind = item.IsThinLock ? "thin" : "syncblk";
    <tr class="dn-tr">
        <td class="dn-td dn-td--mono"><span class="dn-addr">@Display.Address(item.ObjectAddress)</span></td>
        <td class="dn-td dn-td--type" title="@type.Full">
            <span class="dn-trunc"><span class="dn-trunc__head">@type.Head</span><span class="dn-trunc__tail">@type.Tail</span></span>
        </td>
        <td class="dn-td">@kind</td>
        <td class="dn-td">@(item.IsMonitorHeld ? "yes" : "no")</td>
        <td class="dn-td dn-td--mono">@owner</td>
        <td class="dn-td dn-td--num">@Display.Count(item.RecursionCount)</td>
        <td class="dn-td dn-td--num">@Display.Count(item.WaitingThreadCount)</td>
    </tr>
}

@if (Model.Result.HasMore)
{
    int nextOffset = Model.Result.Offset + Model.Result.Items.Count;
    string href = InfiniteScroll.SentinelHref(Model.View, Context.Request.Query, nextOffset, Model.Result.Limit);
    <tr hx-get="@href" hx-trigger="intersect once" hx-swap="afterend" hx-target="this">
        <td colspan="7" class="dn-sentinel"><span class="dn-sentinel__muted">Loading&hellip;</span></td>
    </tr>
}
