@*
    The managed thread list (task 3.3). Copies DumpHeap.cshtml's shape exactly -- see that file's
    doc comment for the four rules this repeats: no style=, the htmx contract as markup, no
    conditionals beyond presence/absence, and formatting logic staying out of the template.

    OSThreadId, the Alive/Dead state, and the exception column mirror
    MarkdownFormatter.FormatThreads exactly, so an id or a state word copied from this table means
    the same thing it does in the CLI or the MCP server's output.

    Task 4.1-4.3: filter bar, chips and sortable headers inside one <form> -- see
    _FilterBar.cshtml's doc comment. ThreadAnalyzer.GetThreads only recognizes "exception" and
    "osthreadid" as SortBy values (anything else falls back to ManagedThreadId), so Mgd ID and
    State stay plain, unsortable headers.

    Task 4.4: the <tr> loop lives in _ClrThreadsRows.cshtml -- see DumpHeap.cshtml's doc comment for why.
*@
@model ListModel<ThreadInfo>
@{
    var filterBar = FilterBar.Build(Model.View, Context.Request.Query);
    var osIdSort = SortHeader.For(Model.View, Context.Request.Query, "osthreadid", SortDirection.Asc);
    var exceptionSort = SortHeader.For(Model.View, Context.Request.Query, "exception", SortDirection.Desc);
}

<div id="v-@Model.View.Name">
    <form class="dn-filterform">
        <partial name="/Views/Shared/_FilterBar.cshtml" model="@filterBar" />
        <table class="dn-table">
            <thead>
                <tr>
                    <th scope="col" class="dn-th dn-th--num">Mgd ID</th>
                    <th scope="col" class="dn-th dn-th--mono" aria-sort="@osIdSort.AriaSort">
                        <a class="dn-th__sort" hx-get="@osIdSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">OS ID@(osIdSort.Indicator)</a>
                    </th>
                    <th scope="col" class="dn-th">State</th>
                    <th scope="col" class="dn-th" aria-sort="@exceptionSort.AriaSort">
                        <a class="dn-th__sort" hx-get="@exceptionSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">Exception@(exceptionSort.Indicator)</a>
                    </th>
                </tr>
            </thead>
            <tbody id="rows-@Model.View.Name">
                <partial name="/Views/Fragments/_ClrThreadsRows.cshtml" model="@Model" />

                @if (Model.Result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="4" class="dn-empty">
                            @* Per DESIGN_BRIEF.md §5: an unfiltered empty result means the dump has no
                               managed threads, whereas a filtered one means the filter is too narrow. *@
                            @if (Model.Result.TotalUnfiltered > 0)
                            {
                                <div class="dn-empty__title">No threads match the current filter.</div>
                                <a class="dn-btn" href="@(filterBar.ClearAllUrl ?? $"/views/{Model.View.Name}")">Clear filters</a>
                            }
                            else
                            {
                                <div class="dn-empty__title">This dump has no managed threads to show.</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
</div>
