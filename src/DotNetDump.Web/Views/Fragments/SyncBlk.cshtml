@*
    The sync blocks list (task 3.3). Copies DumpHeap.cshtml's shape exactly -- see that file's
    doc comment for the four rules this repeats: no style=, the htmx contract as markup, no
    conditionals beyond presence/absence, and formatting logic staying out of the template.

    The columns mirror MarkdownFormatter.FormatSyncBlocks: object address (mono), type name,
    kind (thin/syncblk from IsThinLock), held (bool as text), owner thread (ManagedThreadId if
    present, else @{HoldingThreadAddress:X} if non-zero, else "none"), recursion count, and
    waiting thread count.

    Task 4.1-4.3: filter bar, chips and sortable headers inside one <form> -- see
    _FilterBar.cshtml's doc comment. HeapAnalyzer.GetSyncBlocks only recognizes "recursion" and
    "waiting" as SortBy values (anything else falls back to ObjectAddress), so Object, Type, Lock,
    Held and Owner Thread stay plain, unsortable headers.
*@
@model ListModel<SyncBlockInfo>
@{
    var filterBar = FilterBar.Build(Model.View, Context.Request.Query);
    var recursionSort = SortHeader.For(Model.View, Context.Request.Query, "recursion", SortDirection.Desc);
    var waitingSort = SortHeader.For(Model.View, Context.Request.Query, "waiting", SortDirection.Desc);
}

<div id="v-@Model.View.Name">
    <form class="dn-filterform">
        <partial name="/Views/Shared/_FilterBar.cshtml" model="@filterBar" />
        <table class="dn-table">
            <thead>
                <tr>
                    <th scope="col" class="dn-th dn-th--mono">Object</th>
                    <th scope="col" class="dn-th">Type</th>
                    <th scope="col" class="dn-th">Lock</th>
                    <th scope="col" class="dn-th">Held</th>
                    <th scope="col" class="dn-th">Owner Thread</th>
                    <th scope="col" class="dn-th dn-th--num">
                        <a class="dn-th__sort" aria-sort="@recursionSort.AriaSort" hx-get="@recursionSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">Recursion@(recursionSort.Indicator)</a>
                    </th>
                    <th scope="col" class="dn-th dn-th--num">
                        <a class="dn-th__sort" aria-sort="@waitingSort.AriaSort" hx-get="@waitingSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">Waiting@(waitingSort.Indicator)</a>
                    </th>
                </tr>
            </thead>
            <tbody id="rows-@Model.View.Name">
                @foreach (var item in Model.Result.Items)
                {
                    var type = MiddleTruncated.From(item.TypeName);
                    string owner = item.ManagedThreadId.HasValue
                        ? Display.Count(item.ManagedThreadId.Value)
                        : (item.HoldingThreadAddress != 0 ? "@" + Display.Address(item.HoldingThreadAddress) : "none");
                    string kind = item.IsThinLock ? "thin" : "syncblk";
                    <tr class="dn-tr">
                        <td class="dn-td dn-td--mono"><span class="dn-addr">@Display.Address(item.ObjectAddress)</span></td>
                        <td class="dn-td dn-td--type" title="@type.Full">
                            <span class="dn-trunc"><span class="dn-trunc__head">@type.Head</span><span class="dn-trunc__tail">@type.Tail</span></span>
                        </td>
                        <td class="dn-td">@kind</td>
                        <td class="dn-td">@(item.IsMonitorHeld ? "yes" : "no")</td>
                        <td class="dn-td dn-td--mono">@owner</td>
                        <td class="dn-td dn-td--num">@Display.Count(item.RecursionCount)</td>
                        <td class="dn-td dn-td--num">@Display.Count(item.WaitingThreadCount)</td>
                    </tr>
                }

                @if (Model.Result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="dn-empty">
                            @* Per DESIGN_BRIEF.md §5: an unfiltered empty result means the dump has no
                               sync blocks or thin locks, whereas a filtered one means the filter is too narrow. *@
                            @if (Model.Result.TotalUnfiltered > 0)
                            {
                                <div class="dn-empty__title">No locks match the current filter.</div>
                                <a class="dn-btn" href="@(filterBar.ClearAllUrl ?? $"/views/{Model.View.Name}")">Clear filters</a>
                            }
                            else
                            {
                                <div class="dn-empty__title">This dump has no held monitors found (no sync blocks and no thin locks).</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
</div>
