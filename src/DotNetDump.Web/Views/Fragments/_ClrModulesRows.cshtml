@*
    The row loop for ClrModules.cshtml, factored out (task 4.4) -- see _DumpHeapRows.cshtml's doc
    comment for why this exists and what the trailing sentinel <tr> does.
*@
@model ListModel<ModuleInfo>
@foreach (var item in Model.Result.Items)
{
    <tr class="dn-tr">
        <td class="dn-td dn-td--mono"><span class="dn-addr">@Display.Address(item.ImageBase)</span></td>
        <td class="dn-td dn-td--num" title="@Display.Bytes((long)item.Size)">@Display.Size((long)item.Size)</td>
        <td class="dn-td">@(item.IsUserCode ? "user code" : "system")</td>
        <td class="dn-td dn-td--text">@item.Name</td>
    </tr>
}

@if (Model.Result.HasMore)
{
    int nextOffset = Model.Result.Offset + Model.Result.Items.Count;
    string href = InfiniteScroll.SentinelHref(Model.View, Context.Request.Query, nextOffset, Model.Result.Limit);
    <tr hx-get="@href" hx-trigger="intersect once" hx-swap="afterend" hx-target="this">
        <td colspan="4" class="dn-sentinel"><span class="dn-sentinel__muted">Loading&hellip;</span></td>
    </tr>
}
