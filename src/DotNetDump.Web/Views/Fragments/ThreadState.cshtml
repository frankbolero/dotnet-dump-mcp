@*
    Thread state list view (task 3.3). Copies DumpHeap.cshtml's shape exactly -- see that file's
    doc comment for the four rules this repeats: no style=, the htmx contract as markup, no
    conditionals beyond presence/absence, and formatting logic staying out of the template.

    Columns mirror MarkdownFormatter.FormatThreadStates exactly, so an id or a state word copied
    from this table means the same thing it does in the CLI or the MCP server's output.

    Task 4.1-4.3: filter bar, chips and sortable headers inside one <form> -- see
    _FilterBar.cshtml's doc comment. ThreadAnalyzer.GetThreadStates only recognizes "osthreadid"
    and "lockcount" as SortBy values (anything else falls back to ManagedThreadId), so Mgd ID,
    Address, GC Mode, Apartment, Exception and Flags stay plain, unsortable headers.
*@
@model ListModel<ThreadStateInfo>
@{
    var filterBar = FilterBar.Build(Model.View, Context.Request.Query);
    var osIdSort = SortHeader.For(Model.View, Context.Request.Query, "osthreadid", SortDirection.Asc);
    var lockSort = SortHeader.For(Model.View, Context.Request.Query, "lockcount", SortDirection.Desc);
}

<div id="v-@Model.View.Name">
    <form class="dn-filterform">
        <partial name="/Views/Shared/_FilterBar.cshtml" model="@filterBar" />
        <table class="dn-table">
            <thead>
                <tr>
                    <th scope="col" class="dn-th dn-th--num">Mgd ID</th>
                    <th scope="col" class="dn-th dn-th--mono" aria-sort="@osIdSort.AriaSort">
                        <a class="dn-th__sort" hx-get="@osIdSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">OS ID@(osIdSort.Indicator)</a>
                    </th>
                    <th scope="col" class="dn-th dn-th--mono">Address</th>
                    <th scope="col" class="dn-th">GC Mode</th>
                    <th scope="col" class="dn-th">Apartment</th>
                    <th scope="col" class="dn-th dn-th--num" aria-sort="@lockSort.AriaSort">
                        <a class="dn-th__sort" hx-get="@lockSort.Href" hx-target="#v-@Model.View.Name" hx-push-url="true" hx-include="closest form">Locks@(lockSort.Indicator)</a>
                    </th>
                    <th scope="col" class="dn-th">Exception</th>
                    <th scope="col" class="dn-th">Flags</th>
                </tr>
            </thead>
            <tbody id="rows-@Model.View.Name">
                @foreach (var item in Model.Result.Items)
                {
                    <tr class="dn-tr">
                        <td class="dn-td dn-td--num">@Display.Count(item.ManagedThreadId)</td>
                        <td class="dn-td dn-td--mono"><span class="dn-addr">@Display.ThreadId(item.OSThreadId)</span></td>
                        <td class="dn-td dn-td--mono"><span class="dn-addr">@Display.Address(item.Address)</span></td>
                        <td class="dn-td">@item.GcMode</td>
                        <td class="dn-td">@item.ApartmentState</td>
                        <td class="dn-td dn-td--num">@Display.LockCountOrUnknown(item.LockCount)</td>
                        <td class="dn-td">@Display.OrNone(item.ExceptionType)</td>
                        <td class="dn-td">@(Display.JoinOrDash(item.StateFlags))</td>
                    </tr>
                }

                @if (Model.Result.Items.Count == 0)
                {
                    <tr>
                        <td colspan="8" class="dn-empty">
                            @* Per DESIGN_BRIEF.md §5: an unfiltered empty result means the dump has no
                               thread states, whereas a filtered one means the filter is too narrow. *@
                            @if (Model.Result.TotalUnfiltered > 0)
                            {
                                <div class="dn-empty__title">No threads match the current filter.</div>
                                <a class="dn-btn" href="@(filterBar.ClearAllUrl ?? $"/views/{Model.View.Name}")">Clear filters</a>
                            }
                            else
                            {
                                <div class="dn-empty__title">This dump has no thread states to show.</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </form>
</div>
