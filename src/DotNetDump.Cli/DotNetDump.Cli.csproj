<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DotNetDump.Cli</RootNamespace>
    <AssemblyName>dndump</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Packaged as a dotnet tool per CLI_DESIGN.md §2/§8.1: dotnet tool install (global) dndump. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dndump</ToolCommandName>
    <PackageId>dndump</PackageId>
    <Description>CLI front end for DotNetDump.Core -- .NET memory dump analysis (docs/CLI_DESIGN.md).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetDump.Core\DotNetDump.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

</Project>
