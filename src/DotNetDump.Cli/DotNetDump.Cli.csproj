<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DotNetDump.Cli</RootNamespace>
    <AssemblyName>dndump</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Packaged as a dotnet tool per CLI_DESIGN.md §2/§8.1: dotnet tool install (global) dndump. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dndump</ToolCommandName>
    <PackageId>dndump</PackageId>
    <Description>CLI front end for DotNetDump.Core -- .NET memory dump analysis (docs/CLI_DESIGN.md).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DotNetDump.Core\DotNetDump.Core.csproj" />
    <!-- 'dndump serve' starts the web host in-process (docs/web/SERVER.md §1). One way only: Web
         never references Cli, and neither reaches DotNetDump.Server or ModelContextProtocol.
         Referencing it makes the ASP.NET Core shared framework a runtime requirement of the tool;
         the assemblies are only *loaded* when ServeCommand's action runs, so every other command
         still pays nothing at startup. -->
    <ProjectReference Include="..\DotNetDump.Web\DotNetDump.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.10" />
  </ItemGroup>

</Project>
